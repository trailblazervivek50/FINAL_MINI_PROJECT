# Smart Municipal Dustbin Monitoring Platform - Environment Configuration

# Server Port
PORT=5000

# Database Configuration (PostgreSQL)
# When set, the system connects to PostgreSQL.
# If omitted or unavailable, the system uses the high-performance local database engine.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_dustbin_db

# JWT Secret for operator session authentication
JWT_SECRET=super_secret_municipal_jwt_token_key_2026_xyz

# GIS & Map Configuration
# Leaflet uses OpenStreetMap by default (no API key required).
# Production tile providers (MapTiler, Mapbox, Stadia, etc.) can be configured below.
MAP_PROVIDER=osm
MAP_PROVIDER_API_KEY=
# Example MapTiler URL: https://api.maptiler.com/maps/basic-v2/{z}/{x}/{y}.png?key={API_KEY}
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# Demo Simulation Configuration
DEMO_MODE=true
DEMO_BIN_COUNT=60
DEMO_UPDATE_INTERVAL=20000

# Offline Detection Thresholds (minutes)
ONLINE_THRESHOLD_MINUTES=5
WARNING_THRESHOLD_MINUTES=15
